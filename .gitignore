# Source-only allowlist. Review any new path before making it eligible.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/THIRD_PARTY_NOTICES.md
!/pyproject.toml
!/package.json
!/package-lock.json
!/INVENTORY.json
!/nes_converter/
!/tests/
!/docs/
!/third_party/

# Keep only the reviewed source/resource extensions inside allowed directories.
/nes_converter/**/*
!/nes_converter/**/
!/nes_converter/**/*.py
!/nes_converter/**/*.cjs
!/nes_converter/prompt/template.json
/tests/**/*
!/tests/**/
!/tests/**/*.py
!/tests/fixtures/instinct-system.txt
/docs/*
!/docs/HANDOFF.md
/third_party/*
!/third_party/VS_CODE_LICENSE.txt
!/third_party/INSTINCT_LICENSE.txt

**/__pycache__/
**/*.py[cod]
**/.venv/
**/venv/
**/node_modules/
**/.pytest_cache/
**/build/
**/dist/
**/*.egg-info/
**/.env
**/.env.*
**/.npmrc
**/.pypirc
**/credentials*
**/*secret*
**/*.pem
**/*.key
**/*.pfx
**/*.p12
**/*.jsonl
**/*.parquet
**/*.arrow
**/*.sqlite*
**/*.log
**/data/
**/runs/
**/releases/
**/cache/
